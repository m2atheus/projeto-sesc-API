# PROD — copiar para .env somente no computador de destino.
APP_ENV=production
DATABASE_URL=sqlite:///./data/weather.db
ALLOW_SIMULATED=false
# Substituir loopback pelo IP LAN do servidor antes de conectar o console.
INGEST_HOST=127.0.0.1
INGEST_PORT=8001
# Acrescentar o IP do console e a origem de monitoramento autorizada.
INGEST_NETWORKS=["127.0.0.1/32","::1/128"]
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=8080
TRUSTED_PROXY_IPS=["127.0.0.1"]
CORS_ORIGINS=[]
LOG_LEVEL=INFO
SQLITE_BUSY_TIMEOUT_MS=15000
BACKUP_DIR=./backups/prod
BACKUP_RETENTION_DAYS=30
# Definir BACKUP_SECONDARY_DIR na instalação, em outra unidade física.
