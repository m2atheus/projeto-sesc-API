# DEV — computador pessoal. Todos os caminhos são relativos à raiz do projeto.
APP_ENV=development
DATABASE_URL=sqlite:///./data/weather-dev.db
INGEST_NETWORKS=["127.0.0.1/32","::1/128"]
CORS_ORIGINS=["http://localhost:5173"]
MAX_QUERY_BYTES=8192
MAX_PARAMETERS=128
MAX_PAGE_SIZE=500
ACK_TEXT=OK
DIAGNOSTIC_PAYLOAD=false
ALLOW_SIMULATED=true
LOG_LEVEL=INFO
DEV_PORT=8000
INGEST_HOST=127.0.0.1
INGEST_PORT=8001
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=8080
TRUSTED_PROXY_IPS=[]
SQLITE_BUSY_TIMEOUT_MS=15000
MAX_PERIOD_DAYS=31
MAX_CSV_ROWS=5000
PUBLIC_REQUESTS_PER_MINUTE=120
PUBLIC_TOTAL_PER_MINUTE=1200
CACHE_TTL_SECONDS=60
SUMMARY_CACHE_TTL_SECONDS=300
HISTORY_CACHE_TTL_SECONDS=60
STATION_DELAY_SECONDS=180
STATION_TIMEOUT_SECONDS=600
BACKUP_DIR=./backups/dev
BACKUP_RETENTION_DAYS=30
# Para a instalação futura, veja deploy/production.env.example.
